# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Database (optional, defaults shown)
DATABASE_URL=postgresql+asyncpg://bizon:bizon@localhost:5432/bizon_platform_lite

# Storage (optional, defaults shown)
STORAGE_LOCAL_PATH=/tmp/bizon-outputs
CUSTOM_SOURCES_DIR=./custom_sources

# CORS (optional, defaults shown)
CORS_ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Instance branding (optional, for white-label deployments)
INSTANCE_NAME=Bizon
INSTANCE_DESCRIPTION=Data pipeline orchestration platform

# Authentication (optional)
# If set, all API endpoints (except /api/health) require HTTP Basic Auth.
# Use any username with this password.
# For production, consider using a reverse proxy with proper auth instead.
# ADMIN_PASSWORD=your-secure-password

# Git Sync for Custom Sources (optional, for production deployments)
# When enabled, custom sources are synced from a git repository on startup
# and can be manually synced via the UI or API.
# GIT_SYNC_ENABLED=true
# GIT_SYNC_REPO_URL=https://github.com/your-org/your-sources-repo.git
# GIT_SYNC_BRANCH=main
# GIT_SYNC_PATH=custom_sources
# GIT_SYNC_TOKEN=your-github-pat-for-private-repos
